{
  "name": "@blue-matter/core",
  "version": "1.0.0",
  "description": "A TypeScript library for parsing and updating Markdown front matter.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "test:watch": "node --test --watch tests/*.test.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "front-matter",
    "yaml",
    "json",
    "markdown",
    "typescript",
    "obsidian"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvaAlex/blue-matter.git"
  },
  "bugs": {
    "url": "https://github.com/silvaAlex/blue-matter/issues"
  },
  "homepage": "https://github.com/silvaAlex/blue-matter#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.2",
    "typescript": "^5.6.0"
  }
}
